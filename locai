#!/data/data/com.termux/files/usr/bin/sh
# LocAI - light local LLM server for Termux (no root needed)

LOCAI_HOME="${LOCAI_HOME:-$HOME/.locai}"
CONF="$LOCAI_HOME/config.conf"
PIDFILE="$LOCAI_HOME/server.pid"
LOGFILE="$LOCAI_HOME/server.log"

[ -f "$CONF" ] && . "$CONF"
: "${MODEL:=$LOCAI_HOME/models/model.gguf}"
: "${THREADS:=4}"
: "${CTX:=2048}"
: "${PORT:=8080}"
: "${HOST:=127.0.0.1}"
: "${PARALLEL:=1}"
: "${IDLE_SECONDS:=600}"
: "${WAKE_LOCK:=1}"

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if is_running; then
    echo "LocAI is already running: http://$HOST:$PORT"
    return 0
  fi
  if [ ! -f "$MODEL" ]; then
    echo "Model not found: $MODEL"
    echo "Get one with: locai model <gguf-url>"
    return 1
  fi

  EXTRA=""
  if [ "$IDLE_SECONDS" -gt 0 ] && llama-server --help 2>&1 | grep -q -- "--sleep-idle-seconds"; then
    EXTRA="--sleep-idle-seconds $IDLE_SECONDS"
  fi
  [ "$WAKE_LOCK" = "1" ] && termux-wake-lock 2>/dev/null

  echo "Starting LocAI..."
  nohup llama-server -m "$MODEL" -t "$THREADS" -c "$CTX" -np "$PARALLEL" \
    --host "$HOST" --port "$PORT" $EXTRA >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"

  i=0
  while [ "$i" -lt 60 ]; do
    if curl -fs "http://$HOST:$PORT/health" >/dev/null 2>&1; then
      echo "Ready: http://$HOST:$PORT"
      echo "Chat in your browser: locai chat"
      return 0
    fi
    if ! is_running; then
      echo "Server stopped. Check the log: $LOGFILE"
      rm -f "$PIDFILE"
      return 1
    fi
    i=$((i + 1))
    sleep 1
  done
  echo "Still loading. Check again with: locai status"
}

stop() {
  if is_running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    echo "LocAI stopped."
  else
    echo "LocAI is not running."
  fi
  rm -f "$PIDFILE"
  termux-wake-unlock 2>/dev/null
}

status() {
  if is_running; then
    echo "Running (PID $(cat "$PIDFILE")): http://$HOST:$PORT"
  else
    echo "Stopped."
  fi
}

chat() {
  is_running || start || return 1
  if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "http://$HOST:$PORT"
  else
    echo "Open this in your browser: http://$HOST:$PORT"
  fi
}

model() {
  if [ -z "$1" ]; then
    echo "Usage: locai model <gguf-url>"
    return 1
  fi
  mkdir -p "$LOCAI_HOME/models"
  wget -c "$1" -O "$MODEL.part" && mv "$MODEL.part" "$MODEL" \
    && echo "Model saved. Restart with: locai stop && locai start"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  chat) chat ;;
  model) model "$2" ;;
  log) tail -n 40 "$LOGFILE" ;;
  *)
    echo "LocAI - light local LLM for Termux"
    echo "Usage: locai {start|stop|restart|status|chat|model <url>|log}"
    ;;
esac
